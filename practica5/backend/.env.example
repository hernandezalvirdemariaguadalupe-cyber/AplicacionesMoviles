# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
JWT_SECRET_KEY=cambia-esto-por-una-llave-larga-y-aleatoria
JWT_EXPIRES_MINUTES=1440

# Base de datos: vacío = SQLite en instance/app.db. En Render se usa el Postgres gratuito.
DATABASE_URL=

# IDs de cliente OAuth de Google aceptados (Web, Android e iOS), separados por coma.
# Son identificadores públicos, no secretos; aun así se configuran por variable de entorno.
GOOGLE_CLIENT_IDS=xxxxx-web.apps.googleusercontent.com,xxxxx-ios.apps.googleusercontent.com

# Correos de Google que reciben rol admin.
ADMIN_EMAILS=

# Cuenta admin local (para la demo y las pruebas automáticas). Contraseña de 8+ caracteres.
ADMIN_USERNAME=
ADMIN_PASSWORD=
